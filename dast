#!/usr/bin/env python3
import argparse
import json
import shutil
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent
sys.path.insert(0, str(ROOT))
from backend.app.config import settings
from backend.app.package import analyze_package
from backend.app.storage import load_report


def doctor():
    checks = [("Docker", shutil.which("docker")), ("runsc", shutil.which("runsc")), ("Python", sys.executable), ("pip", shutil.which("pip")), ("cgroup v2", Path("/sys/fs/cgroup/cgroup.controllers").exists()), ("tcpdump", shutil.which("tcpdump")), ("bpftool", shutil.which("bpftool"))]
    for name, value in checks: print(f"[{ 'OK' if value else 'WARN' }] {name}")
    if shutil.which("docker"):
        result = subprocess.run(["docker", "info"], capture_output=True, text=True)
        print(f"[{ 'OK' if result.returncode == 0 else 'WARN' }] Docker daemon")
    print("Environment check complete. gVisor is required for production sandbox execution.")


def main():
    parser = argparse.ArgumentParser(prog="dast"); sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("doctor"); a = sub.add_parser("analyze"); a.add_argument("package"); a.add_argument("--artifact", choices=["auto","wheel","sdist"], default="auto"); a.add_argument("--network", choices=["disabled","restricted","full"], default="restricted"); a.add_argument("--timeout", type=int, default=240)
    r = sub.add_parser("report"); r.add_argument("analysis_id"); sub.add_parser("server"); args = parser.parse_args()
    if args.command == "doctor": doctor()
    elif args.command == "analyze":
        name, sep, version = args.package.partition("=="); report = analyze_package(name, version or None, args.artifact, args.network, args.timeout); print(json.dumps(report.model_dump(), indent=2))
    elif args.command == "report": print(json.dumps(load_report(settings.data_dir, args.analysis_id), indent=2))
    elif args.command == "server":
        import uvicorn; uvicorn.run("backend.app.main:app", host="0.0.0.0", port=8000)

if __name__ == "__main__": main()
